# Phase 0 local infrastructure defaults; demo prices are fictional fixtures.
COMPOSE_PROJECT_NAME=aurafind
POSTGRES_PASSWORD=aurafind_dev
POSTGRES_PORT=5432
MINIO_ROOT_USER=aurafind_dev
MINIO_ROOT_PASSWORD=aurafind_dev_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
API_PORT=8080
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/products
# Development key only. Set a random secret and COOKIE_SECURE=true for HTTPS deployment.
JWT_SECRET=local-development-key-change-before-deployment-aurafind
COOKIE_SECURE=false
SMTP_FROM=noreply@aurafind.local
# Optional public storefront origin for metadata/sitemap (defaults to FRONTEND_PORT locally).
# SITE_URL=https://your-store.example
# Download of public CLIP weights is needed on the first demo seed (no account).
DEMO_MODEL_NAME=openai/clip-vit-base-patch32
DEMO_ADMIN_EMAIL=admin@aurafind.local
DEMO_ADMIN_PASSWORD=aurafind
# Optional background job infrastructure: docker compose --profile jobs up -d
RABBITMQ_USER=aurafind_dev
RABBITMQ_PASS=aurafind_dev_secret
